# Copy to .env for local dev. On Vercel, set these in Project Settings → Environment Variables.

# PostgreSQL connection string. On Vercel, use a Neon (or other managed) Postgres.
# IMPORTANT: use the POOLED connection string on serverless (e.g. Neon's "-pooler" host).
DATABASE_URL=postgres://user:password@host:5432/mealplanner?sslmode=require

# OpenAI API key (used for AI recipe / meal-plan generation; falls back to mock if unset)
OPENAI_API_KEY=

# USDA FoodData Central API key (used for nutrition lookups)
USDA_API_KEY=

ENVIRONMENT=production

# Frontend build-time API base. On Vercel this is set to /api by vercel.json's build command,
# so you normally do NOT need to set it manually.
# REACT_APP_API_URL=/api
