// Web Scraping API
export const scrapingAPI = {
  scrapeRecipe: (url: string): Promise<AxiosResponse<{
    scraped_recipe: ScrapedRecipe;
    suggested_recipe: Partial<Recipe>;
  }>> =>
    api.post('/scrape', { url }),
};

